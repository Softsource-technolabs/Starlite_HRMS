@model IEnumerable<StarLine.Core.Models.TrainingModel>

@{
    ViewData["Title"] = "Index";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h5 class="card-title">Training List</h5>
                <a asp-controller="Training" asp-action="ManageTraining" class="btn btn-sm btn-primary">Add New</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblTrainingList" class="table table-bordered dataTable" data-toggleStatus="@Url.Action("ToggleTrainingStatus", "Training")" data-delete="@Url.Action("DeleteTraining", "Training")">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Category)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Duration)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ValidityMonths)
                                </th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Category)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Duration)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ValidityMonths)
                                    </td>
                                    <td>
                                        <input type="checkbox" class="toggle-status" data-id="@item.Id"
                                        @(item.IsActive ? "checked='checked'" : "") data-toggle="toggle"
                                               data-on="Active" data-off="Inactive" data-onstyle="success" data-offstyle="danger">
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("ManageTraining","Training")?id=@item.Id"><i class="fa-solid fa-pen-to-square"></i></a>
                                        <a class="btn btn-sm btn-outline-danger" id="btn-Delete" data-id='@item.Id'><i class="fa-solid fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/admin/training.js"></script>
}