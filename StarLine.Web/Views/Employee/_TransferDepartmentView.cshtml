@model StarLine.Core.Models.TransferRequestModel
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12 border-bottom pb-2">
        <div class="card-header">
            <h5 class="card-title">Internal Transfer Request Generation</h5>
        </div>
    </div>
</div>

<div class="row mt-3">
    <form id="frmTransferForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />
        <div class="row">
            <div class="col-md-12">
                <label asp-for="EmployeeId" class="control-label">Employee Name</label>
                <div class="form-group">
                    <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeList"></select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12">
                <label asp-for="FromDepartmentId" class="control-label">From Department</label>
                <div class="form-group">
                    <select asp-for="FromDepartmentId" class="form-select" asp-items="ViewBag.FromDepartmets"></select>
                    <span asp-validation-for="FromDepartmentId" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-md-12">
                <label asp-for="ToDepartmentId" class="control-label">To Department</label>
                <div class="form-group">
                    <select asp-for="ToDepartmentId" class="form-select" asp-items="ViewBag.ToDepartmets"></select>
                    <span asp-validation-for="ToDepartmentId" class="text-danger"></span>
                </div>
            </div>
        </div>
        @* <div class="row mt-2">
            <div class="col-md-12">
                <label asp-for="Status" class="control-label">Status</label>
                <div class="form-group">
                    <select asp-for="Status" class="form-select" asp-items="ViewBag.statusList"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>
        </div> *@
        <div class="row mt-2">
            <div class="col-md-12">
                <label asp-for="EffectiveDate" class="control-label">Notes</label>
                <div class="form-group">
                    <input type="date" asp-for="EffectiveDate" value="@DateTime.Today" class="form-control" />
                    <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-md-12">
                <label asp-for="Reason" class="control-label">Notes</label>
                <div class="form-group">
                    <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Reason" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="form-group">
                    <input type="submit" id="submitTransfer" name="submitTransfer" value="Create" class="btn btn-primary w-100" />
                </div>
            </div>
        </div>
    </form>
</div>
