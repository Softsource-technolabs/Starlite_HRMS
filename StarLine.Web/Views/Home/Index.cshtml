@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title">Mark Attendace</h5></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 text-center">
                        <span id="spnStatus" class="fw-medium"></span>
                    </div>
                    <div class="col-md-12 mt-2">
                        <div class="row">
                            <div class="col-md-6">
                                <button id="btnclockIn" name="btnclockIn" type="button" class="btn btn-primary w-100">Clock In</button>
                            </div>
                            <div class="col-md-6">
                                <button id="btnclockOut" name="btnclockOut" type="button" class="btn btn-danger w-100">Clock Out</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title">Shift Details</h5></div>
            <div class="card-body" id="divShiftDetails"></div>
        </div>
    </div>
</div>


<div class="row mt-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title">Attendance</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblAttendance" class="table table-borderless" data-get="@Url.Action("GetMyAttendance", "Home")">
                        <thead>
                            <tr>
                                <th>Employee Name</th>
                                <th>Date</th>
                                <th>In Time</th>
                                <th>Out Time</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title">Holidays</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblHolidays" class="table table-borderless" data-get="@Url.Action("GetCurrentYearHoliday", "Home")">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Holiday Name</th>
                                <th>Type</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h5 class="card-title">Announcement</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblAnnoncement" class="table table-borderless" data-get="@Url.Action("GetAllAnnouncement", "Home")">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="3" class="text-center">No Records found</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/pages/employee/dashboard.js"></script>