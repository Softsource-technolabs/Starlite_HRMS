@using System.Security.Claims
@{
    ViewData["Title"] = "Index";
    var roleName = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
}

<style>
    .status-lable {
        border-radius: 20px;
        display: inline-block;
        width: 80%;
        text-align: center;
        font-weight: 500;
    }
</style>

@if (roleName == "Employee")
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between">
                        <h5 class="card-title">My Leave(s) List</h5>
                        <a class="btn btn-sm btn-primary" onclick="AddUpdateLeave(0)">Add New</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mt-3">
                            <div class="table-responsive">
                                <table id="tblMyLeaves" class="table table-bordered dataTable" data-get="@Url.Action("Get", "Leave")" data-create="@Url.Action("ManageLeave", "Leave")">
                                    <thead>
                                        <tr>
                                            <th>Leave Type</th>
                                            <th>From Date</th>
                                            <th>To Date</th>
                                            <th>Total Days</th>
                                            <th>Duration</th>
                                            <th>Status</th>
                                            <th class="text-center"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <ul class="nav nav-pills border-bottom p-2" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="home-tab" data-bs-toggle="pill" data-bs-target="#MyLeaves" type="button" role="tab">My Leaves</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="profile-tab" data-bs-toggle="pill" data-bs-target="#EmployeeLeaves" type="button" role="tab">Team Leaves</button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="myTabContent">
                        <div class="tab-pane fade show active" id="MyLeaves" role="tabpanel">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title">My Leave(s) List</h5>
                                <a class="btn btn-sm btn-primary" onclick="AddUpdateLeave(0)">Add New</a>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mt-3">
                                    <div class="table-responsive">
                                        <table id="tblMyLeaves" class="table table-bordered dataTable" data-get="@Url.Action("Get", "Leave")" data-create="@Url.Action("ManageLeave", "Leave")">
                                            <thead>
                                                <tr>
                                                    <th>Leave Type</th>
                                                    <th>From Date</th>
                                                    <th>To Date</th>
                                                    <th>Total Days</th>
                                                    <th>Duration</th>
                                                    <th>Status</th>
                                                    <th class="text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="EmployeeLeaves" role="tabpanel">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title">Leave Request(s)</h5>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mt-3">
                                    <div class="table-responsive">
                                        <table id="tblteamLeaves" class="table table-bordered dataTable" data-get="@Url.Action("GetEmployeeLeaves", "Leave")" data-create="@Url.Action("LeaveDetails", "Leave")">
                                            <thead>
                                                <tr>
                                                    <th>Employee Name</th>
                                                    <th>Leave Type</th>
                                                    <th>From Date</th>
                                                    <th>To Date</th>
                                                    <th>Total Days</th>
                                                    <th>Duration</th>
                                                    <th>Status</th>
                                                    <th class="text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/js/pages/employee/leave.js"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
