@model StarLine.Core.Models.LeaveModel
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <form id="frmLeave" asp-action="ManageLeave">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="EmployeeId" type="hidden" />
            <input asp-for="Id" type="hidden" />
            <div class="row">
                <div class="col-md-12">
                    <label asp-for="LeaveTypeId" class="control-label required"></label>
                    <div class="form-group">
                        <select asp-for="LeaveTypeId" class="form-select" asp-items="ViewBag.leaveTypes"></select>
                        <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row mt-2">
                <div class="col-md-12">
                    <label asp-for="FromDate" class="control-label required"></label>
                    <div class="form-group">
                        <input type="date" asp-for="FromDate" class="form-control" value="@DateTime.Now.ToString("yyyy/MM/dd")" />
                        <span asp-validation-for="FromDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12">
                    <label asp-for="ToDate" class="control-label required"></label>
                    <div class="form-group">
                        <input type="date" asp-for="ToDate" class="form-control" value="@DateTime.Now.ToString("yyyy/MM/dd")" />
                        <span asp-validation-for="ToDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12">
                    <label asp-for="TotalDays" class="control-label required"></label>
                    <div class="form-group">
                        <input asp-for="TotalDays" class="form-control readonly-bg" readonly />
                        <span asp-validation-for="TotalDays" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <label asp-for="LeaveDuration" class="control-label required"></label>
                    <div class="form-group">
                        <select asp-for="LeaveDuration" class="form-select" asp-items="ViewBag.LeaveDurations"></select>
                        <span asp-validation-for="LeaveDuration" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12">
                    <label asp-for="ShortDescription" class="control-label required"></label>
                    <div class="form-group">
                        <textarea id="ShortDescription" name="ShortDescription" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <input asp-for="Status" type="hidden" value="@LeaveStatus.Pending" />
            <div class="row mt-5">
                <div class="form-group">
                    @if (Model.Id > 0)
                    {
                        <input type="submit" value="Update" class="btn btn-primary w-100" />
                    }
                    else
                    {
                        <input type="submit" value="Create" class="btn btn-primary w-100" />
                    }
                </div>
                <div class="form-group mt-2">
                    <button type="button" class="btn btn-danger w-100" data-bs-dismiss="offcanvas" aria-label="Close">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

